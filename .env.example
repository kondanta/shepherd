# Where your docker-compose files live. Shepherd scans this directory
# recursively for compose files and uses it as the working directory
# when running docker compose commands. Required.
ROOT_DIR=/srv/compose


# --- Mode (pick one) -------------------------------------------------------

# Webhook mode: set this to your GitHub webhook secret. Shepherd will verify
# incoming push events with HMAC-SHA256 and reject anything that doesn't match.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Polling mode: set this instead of WEBHOOK_SECRET to have Shepherd poll
# the GitHub API on an interval. No public ingress required.
# Format: owner/repo
POLL_REPO=

# How often to poll, in seconds. Default is 300 (5 minutes).
# Only used in polling mode.
POLL_INTERVAL_SECS=300

# Which branch to watch. Default is main.
# Only used in polling mode.
POLL_BRANCH=main


# --- GitHub ----------------------------------------------------------------

# Personal access token for GitHub API calls. Not strictly required, but
# without it you're limited to 60 unauthenticated requests per hour. For
# polling mode with multiple instances, set this.
# Needs read access to repository contents.
GITHUB_TOKEN=

# Shepherd looks for commits authored by Renovate to decide whether to deploy.
# These defaults work for the hosted Renovate app. If you run self-hosted
# Renovate with a different bot identity, override them here.
RENOVATE_USERNAME=renovate[bot]
RENOVATE_EMAIL=renovate[bot]@users.noreply.github.com


# --- Deployment behaviour --------------------------------------------------

# By default, Shepherd refuses to deploy services pinned to the `latest` tag.
# Set to true if you want to allow it. Not recommended.
ALLOW_LATEST_IMAGES=false

# Bearer token for the /flags/* management endpoints (pause, resume, dry-run).
# If not set, those endpoints return 401. Generate one the same way as the
# webhook secret.
API_TOKEN=


# --- Observability ---------------------------------------------------------

# Log level. Defaults to info. Use debug to see what Shepherd is doing
# without deploying anything, or trace if you're chasing something weird.
LOG_LEVEL=info

# gRPC endpoint for OpenTelemetry traces. Only required when Shepherd is
# built with --features otlp. Typically points at a local Grafana Tempo
# or an OTel collector.
OTLP_ENDPOINT=
